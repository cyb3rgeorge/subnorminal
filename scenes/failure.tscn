[sub_resource type="GDScript" id="GDScript_5wfv7"]
script/source = "extends Node2D

func _ready():
	$Control/Anomaly.text = (
		\"Anomaly: \" + str(Global.anomaly) +
		\"\\nNorminals: \" + str(Global.norminals) +
		\"\\nSubnorminals: \" + str(Global.subnorminals)
	)


func _on_restart_pressed() -> void:
	get_tree().change_scene_to_file(Global.SIMULATOR)

func _on_menu_pressed() -> void:
	get_tree().change_scene_to_file(Global.MENU)
"

